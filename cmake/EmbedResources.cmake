# Embeds resources/clicks/*.wav (canonical 44-byte header, 16-bit mono PCM) into
# a generated C++ file. Pure CMake: no external tools, no C++23 #embed.
function(kikset_embed_clicks OUT_FILE CLICK_DIR)
    file(GLOB WAVS "${CLICK_DIR}/*.wav")
    list(SORT WAVS)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${WAVS})
    set(SRC "// Generated by cmake/EmbedResources.cmake - do not edit.\n#include \"ClickBank.hpp\"\n\nnamespace kikset {\n\n")
    set(TABLE "")
    set(COUNT 0)
    foreach(WAV ${WAVS})
        get_filename_component(NAME ${WAV} NAME_WE)
        string(MAKE_C_IDENTIFIER "click_${NAME}" ID)
        file(READ ${WAV} HEX HEX)
        string(LENGTH "${HEX}" HEXLEN)
        math(EXPR DATAHEX "${HEXLEN} - 88")
        string(SUBSTRING "${HEX}" 88 ${DATAHEX} DATA)
        string(REGEX MATCHALL "[0-9a-f][0-9a-f][0-9a-f][0-9a-f]" WORDS "${DATA}")
        set(VALUES "")
        set(LEN 0)
        foreach(W ${WORDS})
            string(SUBSTRING ${W} 0 2 LO)
            string(SUBSTRING ${W} 2 2 HI)
            math(EXPR V "0x${HI}${LO}")
            if(V GREATER 32767)
                math(EXPR V "${V} - 65536")
            endif()
            string(APPEND VALUES "${V},")
            math(EXPR LEN "${LEN} + 1")
            math(EXPR M "${LEN} % 24")
            if(M EQUAL 0)
                string(APPEND VALUES "\n    ")
            endif()
        endforeach()
        string(APPEND SRC "static const int16_t ${ID}[] = {\n    ${VALUES}\n};\n\n")
        string(APPEND TABLE "    {\"${NAME}\", ${ID}, ${LEN}},\n")
        math(EXPR COUNT "${COUNT} + 1")
    endforeach()
    string(APPEND SRC "const ClickData kClicks[] = {\n${TABLE}};\nconst int kClickCount = ${COUNT};\n\n}  // namespace kikset\n")
    file(WRITE "${OUT_FILE}.tmp" "${SRC}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT_FILE}.tmp" "${OUT_FILE}")
endfunction()
